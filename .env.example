# Configure estes valores apenas no painel da Hostinger. Nunca envie o .env real ao GitHub.
NODE_ENV=production
LOOP_ADMIN_PASSWORD=troque-por-uma-senha-unica-com-16-ou-mais-caracteres
LOOP_TRUST_PROXY=true
LOOP_SECURE_COOKIES=true

# Opcional: caminho absoluto persistente fora da pasta substituida em cada deploy.
# LOOP_DB_FILE=/home/USUARIO/domains/SEU-DOMINIO/loop-data/local-db.json
