export const visit = (vm, at) => {
at({ "pt-br": { "conversations-visitor-message-history": { "source": { "one": "{{count}} fonte", "other": "{{count}} fontes", "many": "{{count}} de fontes" }, "sources": "Fontes", "summary": "Resumo", "viewSource": "Exibir fonte", "website": { "singular": "Site", "plural": "Websites" }, "knowledgeBase": "Central de conhecimento", "generatingMessage": "Gerando resposta...", "email-capture": { "thanks": "Obrigado pelo seu e-mail. Entraremos em contato assim que poss\xEDvel.", "invalid": "Voc\xEA digitou um e-mail inv\xE1lido.", "failed": "N\xE3o foi poss\xEDvel confirmar seu endere\xE7o de e-mail.", "placeholderText": "Insira o endere\xE7o de e-mail", "consentToCommunicate": "Eu concordo em receber outras comunica\xE7\xF5es da {{ accountName }}", "submitEmailAddress": "Enviar endere\xE7o de e-mail" }, "initial-message": { "header": "Mensagem de boas-vindas", "headerTooltip": "Uma mensagem de boas-vindas \xE9 um aviso usado para convidar os visitantes do seu site para iniciar uma conversa." }, "common-message": { "hiddenMessage": "Esta mensagem est\xE1 oculta." }, "status": { "publishing": { "UNPUBLISHED": "Enviando...", "PUBLISH_FAILED": "N\xE3o foi entregue. Clique para tentar novamente." } }, "quickReply": { "selectionPlaceholder": "Selecione um", "selectionComplete": "Conclu\xEDdo" }, "agentSays": "Agente disse:", "subjectSays": "{{ subject }} disse:", "iSay": "Eu disse:", "subjectIsTyping": "{{ subject }} est\xE1 digitando", "typingMessage": "Digitando...", "thinkingMessage": "Pensando...", "stillThinkingMessage": "Ainda pensando...", "systemMessage": "Mensagem do sistema:", "agent": "Agente", "bot": "Bot", "system": "Sistema", "avatar": "Avatar de {{ identifier }}", "feedback": { "helpful": "Esta resposta foi \xFAtil para mim", "notHelpful": "Esta resposta n\xE3o foi \xFAtil" }, "unknownVisitor": "Visitante desconhecido", "responder": { "automatic": "Automatizado", "bot": "Bot", "unknownResponder": "Usu\xE1rio desconhecido", "unknownSender": "Remetente desconhecido", "unknownVisitor": "Visitante desconhecido" }, "noContent": "Esta mensagem n\xE3o tem conte\xFAdo", "followUpActions": { "ariaLabel": "A\xE7\xF5es sugeridas" }, "responderJoined": { "joinedConversation": "{{ agentName }} entrou na conversa" } } } });
};