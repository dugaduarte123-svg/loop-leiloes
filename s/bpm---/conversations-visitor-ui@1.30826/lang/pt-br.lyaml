ela separada. Permita pop-ups e tente novamente." }, "knowledgeBaseContainer": { "headerText": "Ajuda", "chat": "Chat" }, "chatTextArea": { "validationMessage": "A mensagem \xE9 muito longa.", "placeholderAskMeAnything": "Pergunte-me qualquer coisa\u2026", "placeholderWriteMessage": "Escreva uma mensagem\u2026" }, "newThreadPrompt": { "newHeading": "O chat foi encerrado.", "newButton": "Para iniciar um novo chat, clique aqui." }, "newThreadPromptSpotlight": { "newHeading": "Seu chat foi encerrado.", "newButton": "Iniciar um novo chat" }, "visitorExperienceAriaLabels": { "attachment": "anexar um arquivo", "chatWidget": "Widget de chat", "messageHistory": "Hist\xF3rico de mensagens", "microphone": "microfone", "playMessageAudio": "reproduzir \xE1udio da mensagem", "closeChatWindow": "Fechar janela de chat", "removeAttachment": "Remover {{fileName}}" }, "spotlightQuickPrompts": { "ariaLabel": "Prompts r\xE1pidos" }, "stagedAttachment": { "uploadProgress": "{{uploadedBytes}} de {{totalBytes}}", "label": "Anexo: {{fileName}}" }, "fileSizeLimit": "O arquivo n\xE3o pode ser maior que {{size}}", "askForEmailMessage": "N\xE3o tem tempo para esperar por uma resposta? Deixe seu e-mail e entraremos em contato assim que poss\xEDvel.", "gdpr": { "consentToCookies": { "promptHeader": "A conversa ser\xE1 perdida se voc\xEA sair", "pageLoadCookieConsent": "Este servi\xE7o de chat utiliza um cookie para interagir com voc\xEA e manter o hist\xF3rico da conversa. Nosso provedor de servi\xE7os monitorar\xE1 e registrar\xE1 este chat para garantir a qualidade (consulte a <a target='_blank' href=\"https://legal.hubspot.com/privacy-policy\" rel='noopener'>Pol\xEDtica de Privacidade</a>).", "exitIntentCookieConsent": "A conversa ser\xE1 perdida se voc\xEA sair desta p\xE1gina sem consentir com o uso de cookies. Este servi\xE7o de chat utiliza um cookie para interagir com voc\xEA e manter o hist\xF3rico da conversa. Nosso provedor de servi\xE7o monitorar\xE1 e registrar\xE1 esta conversa para garantia de qualidade (consulte a <a target='_blank' href=\"https://legal.hubspot.com/privacy-policy\" rel='noopener'>Pol\xEDtica de Privacidade</a>)." } } } } });
