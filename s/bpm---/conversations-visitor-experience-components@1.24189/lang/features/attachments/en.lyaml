export const visit = (vm, at) => {
at({ "en": { "conversations-visitor-experience-components": { "stagedAttachment": { "uploadProgress": "{{uploadedBytes}} of {{totalBytes}}" }, "fileSizeLimit": "The file can't be larger than {{size}}", "screenCapture": "Screen capture", "attachFile": "Attach a file", "screenshotDisabledTooltip": "To take a screenshot, send a message first.", "attachmentDisabledTooltip": "To attach a file, send a message first.", "threadPreview": "An attachment has been sent" } } });
};