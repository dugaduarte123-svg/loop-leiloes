at({ "pt-br": { "conversations-visitor-experience-components": { "threadList": { "chatEndedMessage": "O chat foi encerrado." }, "knowledgeBaseSearch": { "header": "Encontre respostas rapidamente", "seeMoreResults": "Ver mais resultados", "searchLabel": "Pesquisar artigos da central de conhecimento", "searchPlaceholder": "Pesquisar artigos", "clearSearch": "Apagar pesquisa", "noResultsForTerm": "Nenhum resultado para <strong>\"{{ searchTerm }}\"</strong>.<br/> Tente outro termo de pesquisa.", "didntFindResults": "N\xE3o encontrou o que estava procurando?", "goToKnowledgeBase": "Ir para a central de conhecimento", "announceSearchResults": "{{resultsCount}} resultados dispon\xEDveis para {{searchTerm}}", "announceEmptySearchResults": "Nenhum resultado dispon\xEDvel para {{searchTerm}}. Tente outro termo de pesquisa. N\xE3o encontrou o que estava procurando? Acesse o link Ir para a central de conhecimento para buscar respostas." }, "install-code-step": { "description": "<p>Copie o c\xF3digo abaixo e cole-o em todas as p\xE1ginas em que voc\xEA deseja exibir o chat. Ao adicionar o c\xF3digo, verifique se ele est\xE1 posicionado antes do final da tag &lt;body&gt;. Voc\xEA tamb\xE9m pode adicion\xE1-lo ao rodap\xE9 do site.</p><p>Se voc\xEA for um cliente de marketing que usa o HubSpot CMS, n\xE3o precisar\xE1 fazer nada. Seu c\xF3digo de rastreamento ser\xE1 instalado automaticamente em todas as p\xE1ginas hospedadas pela HubSpot.</p>", "howToLink": "Como fa\xE7o para adicionar o c\xF3digo?", "copyButton": "Copiar", "installCodeEmailForm": { "title": "Algu\xE9m mais precisa instalar o c\xF3digo?", "description": "Envie o snippet do c\xF3digo por e-mail ao seu desenvolver da Web ou administrador.", "placeholder": "Insira o endere\xE7o de e-mail", "error": "Insira um endere\xE7o de email v\xE1lido.", "send": "Enviar" } }, "officeHours": { "defaultMessageText": "Retornaremos amanh\xE3 \xE0s 9h00", "sameDay": "Retornaremos hoje \xE0s {{time}}", "nextDay": "Retornaremos amanh\