s em contato assim que poss\xEDvel.", "knowledgeBaseHeaderText": "Ajuda", "agent": "Agente", "aiAgent": "Possibilitado por IA", "avatar": "Avatar de {{ identifier }}", "avatarAvailable": "Avatar de {{ identifier }}; o agente est\xE1 dispon\xEDvel para conversar", "avatarAway": "Avatar de {{ identifier }}; o agente est\xE1 ausente" }, "dateStringWithOn": "em {{ dateString }}", "quickReply": { "selectionPlaceholder": "Selecione um", "selectionComplete": "Enviar" }, "gdpr": { "consentToCookies": { "pageLoadCookieConsent": "Este servi\xE7o de chat utiliza um cookie para interagir com voc\xEA e manter o hist\xF3rico da conversa. Nosso provedor de servi\xE7os monitorar\xE1 e registrar\xE1 este chat para garantir a qualidade (consulte a <a target='_blank' href=\"https://legal.hubspot.com/privacy-policy\" rel='noopener'>Pol\xEDtica de Privacidade</a>)." } }, "knowledgeBase": { "kbHeaderText": "Ajuda", "threadListHeaderText": "Chat", "articleCategories": { "title": "Procurar categorias", "article": "artigo", "articles": "artigos" }, "mostViewed": { "title": "Artigos em alta" }, "highestRated": { "title": "Artigos com melhor avalia\xE7\xE3o" }, "kbArticle": { "backToChat": "Voltar ao chat", "backToKB": "Voltar \xE0 Central de conhecimento", "expand": "Expandir", "collapse": "Recolher", "openInNewTab": "Abrir artigo em uma nova guia" }, "articleNames": { "howToSetupYourAccount": "Como configurar sua conta", "managingYourSubscriptionPlan": "Gerenciando seu plano de assinatura", "dataPrivacyAndSecurity": "Privacidade e seguran\xE7a de dados" }, "categoryNames": { "gettingStarted": "Introdu\xE7\xE3o", "accountAndBilling": "Conta e Cobran\xE7a", "troubleshootingAndFaqs": "Solu\xE7\xE3o de problemas e perguntas frequentes" } }, "askMeAnythingLauncher": { "poweredByAI": "Possibilitado por IA", "placeholder": "Pergunte-me qualquer coisa\u2026" }, "spotlightLauncher": { "placeholder": "Fa\xE7a alguma pergunta", "moreOptions": "Mais op\xE7\xF5es", "sendMessage": "Enviar mensagem", "con