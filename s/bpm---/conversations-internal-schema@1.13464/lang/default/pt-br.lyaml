export const visit = (vm, at) => {
at({ "pt-br": { "conversations-internal-schema": { "default": { "repText": "Ol\xE1! Informe-me se tiver alguma pergunta sobre o produto ou pre\xE7os.", "visitorText": "Voc\xEA pode entrar um pouco mais em detalhes sobre sua estrutura de pre\xE7os?", "name": "Novo fluxo de chat ({{timeStamp}})", "qualifiedLead": { "initialMessage": "Ol\xE1! Terei prazer em ajud\xE1-lo hoje." }, "initialMessage": "Tem alguma pergunta? Ficarei feliz em ajudar.", "askForEmailMessage": "N\xE3o tem tempo para esperar por uma resposta? Deixe seu e-mail e entraremos em contato assim que poss\xEDvel.", "awayMessage": "Estou ausente no momento, mas me informe se tiver d\xFAvidas que responderei em breve.", "gdpr": { "consentToCookies": { "messageExternal": "Este servi\xE7o de chat utiliza um cookie para interagir com voc\xEA e manter o hist\xF3rico da conversa. Nosso provedor de servi\xE7os, a HubSpot, monitorar\xE1 e registrar\xE1 este chat para garantir a qualidade (consulte a <a target=\"_blank\" href=\"https://legal.hubspot.com/privacy-policy\" rel=\"nofollow\">Pol\xEDtica de Privacidade</a>)." }, "consentToProcess": { "defaultConsentTextExternal": "Ao usar este servi\xE7o de chat, voc\xEA concorda com o monitoramento e a grava\xE7\xE3o da conversa e com o processamento dos seus dados pessoais de acordo com a nossa Pol\xEDtica de Privacidade." } } } } } });
};